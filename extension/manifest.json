{
  "manifest_version": 3,
  "name": "Ranilix – אימייל וסיסמה לכל אתר",
  "short_name": "Ranilix",
  "version": "1.1.0",
  "description": "לוחצים, ומקבלים כתובת Ranilix חדשה וסיסמה חזקה לאתר שאתם נרשמים אליו. מעתיקים או ממלאים בדף בלחיצה.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ranilix – אימייל וסיסמה לאתר הזה",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.ranilix.com/*"]
}
